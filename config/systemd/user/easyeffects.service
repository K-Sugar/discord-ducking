[Unit]
Description=EasyEffects audio processing (Discord ducking)
# Must be graphical-session.target, NOT default.target: EasyEffects 8.x is a Qt6/QML
# app and needs WAYLAND_DISPLAY/DISPLAY in the systemd user environment even in
# service mode. default.target fires before the session exports those.
After=graphical-session.target pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/easyeffects --service-mode
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
